{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^(duel|city)-[a-z0-9]{4}$/)",
        ".write": "$room.matches(/^(duel|city)-[a-z0-9]{4}$/)",
        "msgs": {
          "$msg": {
            ".validate": "newData.hasChildren(['k', 'f']) && newData.child('k').isString() && newData.child('k').val().length < 20"
          }
        },
        "p": {
          "$pid": {
            ".validate": "newData.hasChildren(['n', 'c', 'x', 'y']) && newData.child('n').isString() && newData.child('n').val().length <= 16"
          }
        }
      }
    }
  }
}
